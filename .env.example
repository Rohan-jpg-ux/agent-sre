# Application
OBS_ENVIRONMENT=development
OBS_DEBUG=true

# Datastores
OBS_DATABASE_URL=postgresql+asyncpg://obs:obs@localhost:5432/obsagent
OBS_REDIS_URL=redis://localhost:6379/0

# Secrets backend: env | aws_secrets_manager | azure_key_vault | hashicorp_vault | gcp_secret_manager
# Integration credentials are NEVER stored in this file in production.
# The integration row stores only a reference into the backend below.
OBS_SECRET_BACKEND=env
OBS_SECRET_BACKEND_PREFIX=obsagent/integrations

# LLM
ANTHROPIC_API_KEY=
OBS_LLM_MODEL=claude-sonnet-4-6
OBS_LLM_MAX_OUTPUT_TOKENS=4096

# Token budget
OBS_MAX_EVIDENCE_IN_PROMPT=120
OBS_MAX_LOG_ROWS_PER_PROVIDER=5000

# Reliability
OBS_PROVIDER_TIMEOUT_SECONDS=20
OBS_PROVIDER_MAX_RETRIES=3
OBS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
OBS_CIRCUIT_BREAKER_RESET_SECONDS=60

# Correlation
OBS_NEIGHBOUR_WINDOW_SECONDS=120

OBS_DEMO_MODE_ENABLED=true
